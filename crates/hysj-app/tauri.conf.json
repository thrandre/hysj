{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hysj",
  "identifier": "app.hysj.desktop",
  "build": {
    "frontendDist": "ui/dist",
    "beforeBuildCommand": {
      "script": "npm ci && npm run build",
      "cwd": "ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hysj",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 22,
          "y": 36
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "A noise-free mail client",
    "copyright": "© 2026 Thomas René Westlund-Andresen · MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDMDJFNzlDMzcwM0VBMDkKUldRSjZnTTNuT2NDWERQNDBTUXFiaU1kVWhwUjEzdVBuM2JaWVlZWGxtZlBJa2dWT2swZEUvOGYK",
      "endpoints": [
        "https://github.com/thrandre/hysj/releases/latest/download/latest.json"
      ]
    }
  }
}
